# Server only. Set ONE of these keys; Gemini is used first if both are set.
# Gemini (free tier available): create a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
# Optional. Comma-separated models tried in order when the primary is busy.
# Defaults to gemini-3.5-flash,gemini-3.5-flash-lite.
GEMINI_FALLBACK_MODELS=

OPENAI_API_KEY=
# Optional. Defaults to gpt-5.4-mini.
OPENAI_MODEL=

# Optional. Force "google" or "openai" when both keys are set.
AI_PROVIDER=

# Optional. Server only. Turns on Luganda voice and translation (speech-to-text,
# Luganda <-> English, text-to-speech). Free account at https://api.sunbird.ai
SUNBIRD_API_KEY=
# Optional. Luganda voice for read-aloud answers. Defaults to Namuli.
# Others: Kato, Nakato, Wasswa, Babirye, Kizza, Ssemanda, Nalukwago.
SUNBIRD_TTS_VOICE=

# Test only. Makes the voice routes use a fixed fixture instead of Sunbird.
# playwright.config.ts sets it; never set it anywhere else. Ignored when VERCEL_ENV=production.
E2E_MOCK_VOICE=
